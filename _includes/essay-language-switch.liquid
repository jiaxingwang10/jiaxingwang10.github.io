{% if page.translation_url %}
  <nav aria-label="Article language" style="margin-bottom: 1.25rem; font-size: 0.9rem;">
    {% if page.lang == 'zh-CN' %}
      <a href="{{ page.translation_url | relative_url }}" lang="en" hreflang="en">English</a>
      <span aria-hidden="true"> / </span><span lang="zh-CN" aria-current="page">中文</span>
    {% else %}
      <span lang="en" aria-current="page">English</span><span aria-hidden="true"> / </span>
      <a href="{{ page.translation_url | relative_url }}" lang="zh-CN" hreflang="zh-CN">中文</a>
    {% endif %}
  </nav>
{% endif %}
