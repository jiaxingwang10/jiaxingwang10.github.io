#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
preview_url="http://127.0.0.1:4002"
preview_pid=""

export PATH="/opt/homebrew/opt/ruby/bin:/opt/homebrew/bin:$PATH"
if [[ -d /tmp/jiaxing-site-bundle ]]; then
  export BUNDLE_PATH=/tmp/jiaxing-site-bundle
fi

cleanup() {
  if [[ -n "$preview_pid" ]]; then
    kill "$preview_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if ! command -v cloudflared >/dev/null 2>&1; then
  echo "未找到 cloudflared，请先运行：brew install cloudflared"
  exit 1
fi

cd "$repo_dir"
if ! curl --noproxy '*' -fsS --max-time 2 "$preview_url/blog/" >/dev/null 2>&1; then
  preview_log="$(mktemp /tmp/jiaxing-blog-preview.XXXXXX)"
  echo "正在启动本地博客预览，日志：$preview_log"
  bundle exec jekyll serve --drafts --host 127.0.0.1 --port 4002 >"$preview_log" 2>&1 &
  preview_pid=$!
  preview_ready=false
  for ((attempt=0; attempt<90; attempt++)); do
    if curl --noproxy '*' -fsS --max-time 2 "$preview_url/blog/" >/dev/null 2>&1; then
      preview_ready=true
      break
    fi
    if ! kill -0 "$preview_pid" 2>/dev/null; then
      break
    fi
    sleep 1
  done
  if [[ "$preview_ready" != true ]]; then
    echo "本地预览未能启动，最近的日志："
    tail -40 "$preview_log"
    exit 1
  fi
fi

echo "本地预览已就绪，正在创建临时分享链接……"
echo "找到下面输出中的 https://……trycloudflare.com，在末尾加 /blog/ 即可分享。"
echo "持有链接的人可以访问预览。请保持终端打开、电脑联网且不休眠；按 Ctrl+C 停止分享。"
echo "如果出现 no such host 或 NXDOMAIN，请检查当前网络能否解析 api.trycloudflare.com。"
cloudflared tunnel --url "$preview_url" --no-autoupdate --protocol http2
